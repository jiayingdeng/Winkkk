<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App基础信息 -->
	<key>CFBundleIdentifier</key>
	<string>com.winkkk.app</string>
	
	<key>CFBundleName</key>
	<string>Winkkk</string>
	
	<key>CFBundleDisplayName</key>
	<string>Winkkk</string>
	
	<key>CFBundleVersion</key>
	<string>1</string>
	
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	
	<!-- iOS应用标识 -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- 支持的最低iOS版本 -->
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	
	<!-- Scene配置 (iOS 13+) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	
	<!-- 权限描述 -->
	<key>NSCameraUsageDescription</key>
	<string>此App需要访问您的相机来录制视频，让您能够捕捉精彩瞬间并创建完美截图。</string>
	
	<key>NSMicrophoneUsageDescription</key>
	<string>此App需要访问您的麦克风来录制包含音频的视频，为您提供完整的视听体验。</string>
	
	<key>NSPhotoLibraryUsageDescription</key>
	<string>此App需要访问您的相册来导入视频文件，让您能够从已有视频中截取精美图片。</string>
	
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>此App需要保存处理后的图片到您的相册，让您可以轻松保存和分享您的作品。</string>
	
	<!-- 支持的设备方向 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	
	<!-- 状态栏配置 -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	
	<!-- 启动屏幕 -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	
	<!-- App传输安全设置 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	
	<!-- 支持的文件类型 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Movie</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.mpeg-4</string>
			</array>
		</dict>
	</array>
	
	<!-- 导出的类型标识符 -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.winkkk.screenshot</string>
			<key>UTTypeDescription</key>
			<string>Winkkk Screenshot</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
</dict>
</plist>